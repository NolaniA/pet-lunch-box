    "@heroui/toast": "2.0.19",
    "@react-aria/ssr": "3.9.10",
    "@react-aria/visually-hidden": "3.8.29",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.76.1",
